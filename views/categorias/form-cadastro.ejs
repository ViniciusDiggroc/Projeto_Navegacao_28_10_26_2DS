<%- include("../partials/header") %>
<%- include("../partials/nav") %>

<main class="container page-shell">
  <div class="row justify-content-center">
    <div class="col-lg-7">
      <div class="form-card">
        <span class="eyebrow">Cadastro</span>
        <h2 class="mb-4">Nova categoria</h2>

        <% if (error) { %>
          <div class="flash-message flash-error"><%= error %></div>
        <% } %>

        <form action="/categorias" method="POST">
          <div class="mb-3">
            <label for="nome" class="form-label">Nome</label>
            <input type="text" class="form-control" id="nome" name="nome" placeholder="Digite o nome da categoria" required />
          </div>

          <div class="mb-4">
            <label for="descricao" class="form-label">Descrição</label>
            <textarea class="form-control" id="descricao" name="descricao" rows="4" placeholder="Descreva a categoria" required></textarea>
          </div>

          <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="primary-btn">Salvar categoria</button>
            <a href="/categorias" class="secondary-btn">Cancelar</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</main>

<%- include("../partials/footer") %>

<%- include("../partials/header") %>
<%- include("../partials/nav") %>

<main class="container page-shell">
  <section class="hero-card">
    <span class="eyebrow">Cadastro</span>
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
      <div>
        <h1 class="mb-1">Categorias</h1>
        <p>Lista de categorias cadastradas.</p>
      </div>
      <a href="/categorias/cadastro" class="primary-btn">+ Nova categoria</a>
    </div>
  </section>

  <% if (success) { %>
    <div class="flash-message flash-success"><%= success %></div>
  <% } %>

  <% if (error) { %>
    <div class="flash-message flash-error"><%= error %></div>
  <% } %>

  <div class="panel-card p-3 p-md-4">
    <% if (categorias.length === 0) { %>
      <p class="empty-state">Nenhuma categoria cadastrada.</p>
    <% } else { %>
      <div class="table-responsive">
        <table class="table align-middle">
          <thead>
            <tr>
              <th>ID</th>
              <th>Nome</th>
              <th>Descrição</th>
              <th style="width: 210px;">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% categorias.forEach((categoria) => { %>
              <tr>
                <td><%= categoria.id %></td>
                <td><%= categoria.nome %></td>
                <td><%= categoria.descricao %></td>
                <td>
                  <div class="action-group">
                    <a class="success-btn" href="/categorias/editar/<%= categoria.id %>">Editar</a>
                    <a class="danger-btn" href="/categorias/excluir/<%= categoria.id %>" onclick="return confirm('Deseja realmente excluir esta categoria?')">Excluir</a>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</main>

<%- include("../partials/footer") %>

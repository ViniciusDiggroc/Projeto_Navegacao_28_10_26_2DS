<%- include("../partials/header") %>
<%- include("../partials/nav") %>

<main class="container page-shell">
  <div class="row justify-content-center">
    <div class="col-lg-7">
      <div class="form-card">
        <span class="eyebrow">Cadastro</span>
        <h2 class="mb-4">Novo cliente</h2>

        <% if (error) { %>
          <div class="flash-message flash-error"><%= error %></div>
        <% } %>

        <form action="/cliente" method="POST">
          <div class="mb-3">
            <label for="nome" class="form-label">Nome</label>
            <input type="text" class="form-control" id="nome" name="nome" placeholder="Digite o nome do cliente" required />
          </div>

          <div class="mb-3">
            <label for="email" class="form-label">E-mail</label>
            <input type="email" class="form-control" id="email" name="email" placeholder="cliente@email.com" required />
          </div>

          <div class="mb-4">
            <label for="telefone" class="form-label">Telefone</label>
            <input type="tel" class="form-control" id="telefone" name="telefone" placeholder="(11) 99999-9999" required />
          </div>

          <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="primary-btn">Salvar cliente</button>
            <a href="/cliente" class="secondary-btn">Cancelar</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</main>

<%- include("../partials/footer") %>

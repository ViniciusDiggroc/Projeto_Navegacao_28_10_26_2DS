<%- include("../partials/header") %>
<%- include("../partials/nav") %>

<main class="container page-shell">
  <section class="hero-card">
    <span class="eyebrow">Cadastro</span>
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
      <div>
        <h1 class="mb-1">Clientes</h1>
        <p>Lista de clientes cadastrados.</p>
      </div>
      <a href="/cliente/cadastro" class="primary-btn">+ Novo cliente</a>
    </div>
  </section>

  <% if (success) { %>
    <div class="flash-message flash-success"><%= success %></div>
  <% } %>

  <% if (error) { %>
    <div class="flash-message flash-error"><%= error %></div>
  <% } %>

  <div class="panel-card p-3 p-md-4">
    <% if (clientes.length === 0) { %>
      <p class="empty-state">Nenhum cliente cadastrado.</p>
    <% } else { %>
      <div class="table-responsive">
        <table class="table align-middle">
          <thead>
            <tr>
              <th>ID</th>
              <th>Nome</th>
              <th>E-mail</th>
              <th>Telefone</th>
              <th style="width: 210px;">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% clientes.forEach((cliente) => { %>
              <tr>
                <td><%= cliente.id %></td>
                <td><%= cliente.nome %></td>
                <td><%= cliente.email %></td>
                <td><%= cliente.telefone %></td>
                <td>
                  <div class="action-group">
                    <a class="success-btn" href="/cliente/editar/<%= cliente.id %>">Editar</a>
                    <a class="danger-btn" href="/cliente/excluir/<%= cliente.id %>" onclick="return confirm('Deseja realmente excluir este cliente?')">Excluir</a>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</main>

<%- include("../partials/footer") %>

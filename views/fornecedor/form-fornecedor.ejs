<%- include("../partials/header") %>
<%- include("../partials/nav") %>

<main class="container page-shell">
  <div class="row justify-content-center">
    <div class="col-lg-7">
      <div class="form-card">
        <span class="eyebrow">Cadastro</span>
        <h2 class="mb-4">Novo fornecedor</h2>

        <% if (error) { %>
          <div class="flash-message flash-error"><%= error %></div>
        <% } %>

        <form action="/fornecedor" method="POST">
          <div class="mb-3">
            <label for="nome" class="form-label">Nome</label>
            <input type="text" class="form-control" id="nome" name="nome" placeholder="Digite o nome do fornecedor" required />
          </div>

          <div class="mb-3">
            <label for="cnpj" class="form-label">CNPJ</label>
            <input type="text" class="form-control" id="cnpj" name="cnpj" placeholder="00.000.000/0001-00" required />
          </div>

          <div class="mb-4">
            <label for="telefone" class="form-label">Telefone</label>
            <input type="tel" class="form-control" id="telefone" name="telefone" placeholder="(11) 99999-9999" required />
          </div>

          <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="primary-btn">Salvar fornecedor</button>
            <a href="/fornecedor" class="secondary-btn">Cancelar</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</main>

<%- include("../partials/footer") %>

<%- include("../partials/header") %>
<%- include("../partials/nav") %>

<main class="container page-shell">
  <section class="hero-card">
    <span class="eyebrow">Cadastro</span>
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
      <div>
        <h1 class="mb-1">Fornecedores</h1>
        <p>Lista de fornecedores cadastrados.</p>
      </div>
      <a href="/fornecedor/cadastro" class="primary-btn">+ Novo fornecedor</a>
    </div>
  </section>

  <% if (success) { %>
    <div class="flash-message flash-success"><%= success %></div>
  <% } %>

  <% if (error) { %>
    <div class="flash-message flash-error"><%= error %></div>
  <% } %>

  <div class="panel-card p-3 p-md-4">
    <% if (fornecedores.length === 0) { %>
      <p class="empty-state">Nenhum fornecedor cadastrado.</p>
    <% } else { %>
      <div class="table-responsive">
        <table class="table align-middle">
          <thead>
            <tr>
              <th>ID</th>
              <th>Nome</th>
              <th>CNPJ</th>
              <th>Telefone</th>
              <th style="width: 210px;">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% fornecedores.forEach((fornecedor) => { %>
              <tr>
                <td><%= fornecedor.id %></td>
                <td><%= fornecedor.nome %></td>
                <td><%= fornecedor.cnpj %></td>
                <td><%= fornecedor.telefone %></td>
                <td>
                  <div class="action-group">
                    <a class="success-btn" href="/fornecedor/editar/<%= fornecedor.id %>">Editar</a>
                    <a class="danger-btn" href="/fornecedor/excluir/<%= fornecedor.id %>" onclick="return confirm('Deseja realmente excluir este fornecedor?')">Excluir</a>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</main>

<%- include("../partials/footer") %>

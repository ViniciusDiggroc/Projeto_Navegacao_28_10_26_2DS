<%- include("../partials/header") %>
    <%- include("../partials/nav") %>
        <div class="container mt-5">
            <div class="d-flex justify-content-between
                align-items-center mb-4">
                <div>
                    <h1>Produtos</h1>
                    <p class="text-muted">
                        Lista de produtos cadastrados
                    </p>
                </div>
                <a href="/produto/cadastro" class="btn btn-primary">
                    + Novo Produto
                </a>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover
                              align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Nome</th>
                                    <th>Descrição</th>
                                    <th>Opções</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% produtos.forEach(mostrar=> { %>
                                    <tr>
                                        <td>
                                            <%= mostrar.id %>
                                        </td>
                                        <td>
                                            <%= mostrar.nome %>
                                        </td>
                                        <td>
                                            <%= mostrar.descricao %>
                                        </td>
                                        <td>
                                            <a class="btn btn-danger btn-sm"
                                                href="/produto/excluir/<%= mostrar.id%>"
                                                onclick="return confirm('Deseja excluir esse produto?')">Excluir</a>

                                            <a class="btn btn-success btn-sm"
                                                href="/produto/editar/<%= mostrar.id%>">
                                                Editar
                                            </a>

                                        </td> 
                                    </tr>
                                    <% }) %>+
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <%- include("../partials/footer")%>